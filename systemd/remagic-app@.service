[Unit]
Description=ReMagic foreground application %i
Requires=remagicd.service
Wants=remagic-agentd.socket
BindsTo=remagic-display-host.service
After=remagicd.service remagic-display-host.service remagic-agentd.socket
ConditionPathExists=/run/remagic/managed-domain
OnFailure=remagic-app-failed@%i.service

[Service]
Type=simple
ExecStart=/home/root/apps/remagic/bin/remagic-runner %i
Environment=LD_LIBRARY_PATH=/home/root/apps/remagic/lib:/usr/lib/plugins/scenegraph:/usr/lib
Environment=REMAGIC_QTFB_SOCKET=/tmp/qtfb.sock
Environment=REMAGIC_AGENT_SOCKET=/run/remagic/agent.sock
Environment=REMAGIC_PLATFORM_CAPABILITIES=display:qtfb-v1,display:surface-v2,input:touch-v1,input:pen-v1,input:mode-v2,ink:direct-v1,lifecycle:v2,network:outbound-v1,network:listen-v1,network:lan-peer-v1,storage:books-write-v1,storage:wallpapers-write-v1,sync:koreader-state-v1,agent:pi-v1
Restart=no
TimeoutStopSec=8
# The runner translates SIGTERM into the manifest lifecycle shutdown first;
# core validation caps that absolute deadline at 5.5 seconds, leaving time
# for runner task drain and its bounded callback before this cgroup fence.
KillMode=mixed
SendSIGKILL=yes
UMask=0077
