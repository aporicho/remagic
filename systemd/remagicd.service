[Unit]
Description=ReMagic application and foreground-domain manager
After=home.mount local-fs.target xochitl.service
Wants=xochitl.service
Conflicts=remagic-runtime.service magicpaper-takeover.service magicpaper-power-launcher.service riddle-takeover.service riddle-power-launcher.service appload.service rm-appload.service
OnFailure=remagic-recover.service
RequiresMountsFor=/home/root/apps/remagic

[Service]
Type=simple
ExecStart=/home/root/apps/remagic/bin/remagicd
Restart=on-failure
# Give the single recovery transaction time to restore stock ownership before
# systemd considers an automatic restart. The recovery helper may start the
# daemon sooner after it has verified all ownership postconditions.
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=15
RuntimeDirectory=remagic
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
