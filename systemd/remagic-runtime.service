[Unit]
Description=Remagic Qt e-paper application runtime
BindsTo=remagicd.service
After=home.mount remagicd.service
RequiresMountsFor=/home/root/apps/remagic /home/root/apps/riddle /home/root/apps/koreader
OnFailure=remagic-recover.service

[Service]
Type=simple
ExecStart=/home/root/apps/remagic/libexec/remagic-runtime
Environment=LD_LIBRARY_PATH=/home/root/apps/remagic/lib:/usr/lib/plugins/scenegraph:/usr/lib
# Give the runtime the first SIGTERM so it can ask KOReader to save and exit.
# systemd still kills the whole cgroup if the graceful timeout is exceeded.
KillMode=mixed
# RuntimeControl gives KOReader 5.5 seconds before a forced kill and publishes
# its QTFB/display teardown fence by 6.5 seconds; keep systemd outside that fence.
TimeoutStopSec=8
Restart=no
UMask=0077
