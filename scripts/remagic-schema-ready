#!/bin/sh
set -eu

[ "$#" -eq 3 ] || exit 2
fence=$1
app_id=$2
version=$3

case "$app_id" in
    ''|*[!a-z0-9-]*) exit 2 ;;
esac
case "$version" in
    ''|*[!0-9]*|0) exit 2 ;;
esac

[ -f "$fence" ] && [ ! -L "$fence" ] || exit 1
[ "$(stat -c %u "$fence")" -eq "$(id -u)" ] || exit 1
expected=$app_id:$version
[ "$(wc -c < "$fence")" -eq "$((${#expected} + 1))" ] || exit 1
IFS= read -r actual < "$fence" || exit 1
[ "$actual" = "$expected" ]
