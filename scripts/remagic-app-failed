#!/bin/sh
set -eu

app=${1:-}
ctl=${REMAGIC_CTL:-/home/root/apps/remagic/bin/remagicctl}
recover=${REMAGIC_RECOVER:-/home/root/apps/remagic/libexec/remagic-recover}
runtime_root=${REMAGIC_RUNTIME_ROOT:-/run/remagic/apps}

case $app in
    ''|*[!a-z0-9-]*|-*|*-) exec "$recover" ;;
esac
[ "${#app}" -le 64 ] || exec "$recover"

status=$runtime_root/$app/lifecycle-status.json
generation=$(sed -n \
    's/.*"generation":[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
    "$status" 2>/dev/null | sed -n '1p')
case $generation in
    ''|0|*[!0-9]*) exec "$recover" ;;
esac

if "$ctl" runtime-exited "$app" --generation "$generation" \
        --exit-code 1 --crashed >/dev/null; then
    exit 0
fi
exec "$recover"
