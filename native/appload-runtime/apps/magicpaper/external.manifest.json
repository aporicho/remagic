{
  "name": "MagicPaper",
  "application": "/home/root/apps/remagic/libexec/magicpaper-qtfb",
  "workingDirectory": "/home/root/apps/riddle",
  "environment": {
    "RIDDLE_SYSTEMD_MANAGED": "1",
    "REMAGIC_RUNTIME_MANAGED": "1",
    "REMAGIC_RUNTIME_SOCKET": "/run/remagic/runtime-app.sock",
    "REMAGIC_SESSION": "1",
    "LD_LIBRARY_PATH": "/home/root/apps/riddle:/home/root/apps/remagic/lib:/usr/lib/plugins/scenegraph:/usr/lib"
  },
  "qtfb": true,
  "aspectRatio": "move",
  "disablesWindowedMode": true
}
