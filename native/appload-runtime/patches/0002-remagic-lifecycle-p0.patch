+bool RuntimeControl::eventMatchesEpoch(const QString &app, quint64 foregroundEpoch) const
+{
+    const auto position = _appStatuses.constFind(app);
+    return position != _appStatuses.cend() && foregroundEpoch != 0
+        && position->foregroundEpoch == foregroundEpoch;
+}
+
+void RuntimeControl::recordAppEventAtEpoch(const QString &app, const QString &event,
+                                           quint64 foregroundEpoch)
+{
+    if (!eventMatchesEpoch(app, foregroundEpoch)) {
+        CERR << "remagic-runtime: app=" << app.toStdString()
+             << " event=stale-event-ignored stale_event=" << event.toStdString()
+             << " foreground_epoch=" << foregroundEpoch << std::endl;
+        return;
+    }
+    AppRuntimeStatus &status = _appStatuses[app];
+    if (event == "qtfb-connected") status.qtfbConnected = true;
+    else if (event == "qtfb-disconnected") {
+        status.qtfbConnected = false;
+        status.firstFrame = false;
+    } else if (event == "first-frame") status.firstFrame = true;
+    CERR << "remagic-runtime: app=" << app.toStdString()
+         << " event=" << event.toStdString()
+         << " generation=" << status.generation
+         << " foreground_epoch=" << foregroundEpoch << std::endl;
+}
+
+void RuntimeControl::setAppForeground(const QString &app, quint64 foregroundEpoch)
