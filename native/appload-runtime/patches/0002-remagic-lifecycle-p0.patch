+
+void FBController::scheduleCompleteRefresh(quint64 epoch)
+{
+    if (epoch == 0) {
+        if (_manualRefreshScheduled) return;
+        _manualRefreshScheduled = true;
+    } else {
+        if (epoch <= _completedRefreshEpoch || epoch == _scheduledRefreshEpoch) return;
+        _scheduledRefreshEpoch = epoch;
+    }
+    QPointer<FBController> guard(this);
+    QTimer::singleShot(0, this, [guard, epoch]() {
+        if (guard) guard->performCompleteRefresh(epoch);
+    });
+}
+
+void FBController::performCompleteRefresh(quint64 epoch)
+{
+    if (epoch == 0) {
+        _manualRefreshScheduled = false;
+    } else {
+        if (_scheduledRefreshEpoch != epoch || epoch <= _completedRefreshEpoch) return;
+        _scheduledRefreshEpoch = 0;
+    }
+    QQuickWindow *quickWindow = window();
+    const QRect panel(0, 0,
+                      quickWindow ? quickWindow->width() : qCeil(width()),
+                      quickWindow ? quickWindow->height() : qCeil(height()));
+    const bool submitted = submitCompleteRefresh(panel);
+    if (submitted && epoch != 0) {
+        _completedRefreshEpoch = epoch;
+        _lastAutomaticRefresh.restart();
+    }
+    CERR << "remagic-runtime: event="
+         << (epoch == 0 ? "manual-full-refresh-complete" : "panel-complete-refresh")
+         << " foreground_epoch=" << epoch
+         << " submitted=" << (submitted ? "true" : "false") << std::endl;
+    emit fullRefreshCompleted(epoch, submitted);
+}
