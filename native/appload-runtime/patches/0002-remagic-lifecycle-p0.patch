+
+void RuntimeControl::pollShutdown()
+{
+    if (!_shuttingDown || _qtfbStopped) return;
+    if (!_forceShutdownIssued && _shutdownElapsed.elapsed() >= 2200) {
+        _forceShutdownIssued = true;
+        appload::library::forceShutdownExternalApplications();
+    }
+    const bool processesDrained = appload::library::externalApplicationCount() == 0;
+    const bool qtfbDrained = qtfb::management::activeConnectionCount() == 0;
+    if ((!processesDrained || !qtfbDrained) && _shutdownElapsed.elapsed() < 4500) return;
+
+    if (_shutdownTimer) _shutdownTimer->stop();
+    // Let pidDied, QTFB disassociation and deleteLater callbacks run while the
+    // GUI event loop and QML engine are still alive.  The next turn then joins
+    // the QTFB workers and publishes the display teardown fence.
+    QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+    QTimer::singleShot(0, this, [this]() {
+        qtfb::management::stop();
+        _qtfbStopped = true;
+        CERR << "remagic-runtime: event=teardown-complete"
+             << " elapsed_ms=" << _shutdownElapsed.elapsed() << std::endl;
+        QTimer::singleShot(0, QCoreApplication::instance(), &QCoreApplication::quit);
+    });
+}
