+qsizetype appload::library::externalApplicationCount()
+{
+    qsizetype count = 0;
+    for (const auto &[applicationID, process] : externalProcesses) {
+        Q_UNUSED(applicationID);
+        if (process && process->state() != QProcess::NotRunning) ++count;
+    }
+    return count;
+}
+
+void appload::library::beginShutdownExternalApplications()
+{
+    std::vector<qint64> pids;
+    pids.reserve(externalProcesses.size());
+    for (const auto &[applicationID, process] : externalProcesses) {
+        Q_UNUSED(applicationID);
+        if (process && process->state() != QProcess::NotRunning)
+            pids.push_back(process->processId());
+    }
+    for (const qint64 pid : pids) terminateExternal(pid);
+}
+
+void appload::library::forceShutdownExternalApplications()
+{
+    for (const auto &[applicationID, process] : externalProcesses) {
+        Q_UNUSED(applicationID);
+        if (!process || process->state() == QProcess::NotRunning) continue;
+        process->setProperty("remagicExpectedExit", true);
+        signalProcessGroup(process->processId(), SIGKILL);
+    }
+}
