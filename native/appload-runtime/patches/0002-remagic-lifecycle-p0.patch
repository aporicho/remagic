+bool submitCompleteRefresh(const QRect &panel)
+{
+    static const FramebufferInstance instance = reinterpret_cast<FramebufferInstance>(
+        dlsym(RTLD_DEFAULT, "_ZN13EPFramebuffer8instanceEv"));
+    static const FramebufferSwap swap = reinterpret_cast<FramebufferSwap>(
+        dlsym(RTLD_DEFAULT,
+              "_ZN13EPFramebuffer11swapBuffersE5QRect13EPContentType12EPScreenMode6QFlagsINS_10UpdateFlagEE"));
+    if (!instance || !swap || panel.isEmpty()) {
+        return false;
+    }
+    void *framebuffer = instance();
+    if (!framebuffer) {
+        return false;
+    }
+    // The vendor ABI returns void (verified from the device library).  Once
+    // the symbol and framebuffer instance are valid, a normal return means
+    // the refresh was submitted; reading a synthetic return register here
+    // would misclassify valid updates as failures.
+    return (swap(framebuffer, panel, 1, 4, 1), true);
+}
