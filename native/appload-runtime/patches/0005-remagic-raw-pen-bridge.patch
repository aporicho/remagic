+
+void FBController::setForegroundInput(bool foreground)
+{
+    if (_foregroundInput == foreground) {
+        return;
+    }
+    if (foreground && rawPenOwner && rawPenOwner != this) {
+        rawPenOwner->setForegroundInput(false);
+    }
+    if (!foreground && _rawPenBridge) {
+        // Deliver a final release to the old foreground client before
+        // relinquishing ownership so its virtual pen cannot remain down.
+        _rawPenBridge->stop();
+    }
+    _foregroundInput = foreground;
+    if (foreground) {
+        rawPenOwner = this;
+    } else if (rawPenOwner == this) {
+        rawPenOwner.clear();
+    }
+    if (foreground) {
+        updateRawPenBridge();
+    }
+    emit foregroundInputChanged();
+}
+
+void FBController::updateRawPenBridge()
+{
+    if (!_rawPenBridge) {
+        return;
+    }
+    if (_foregroundInput && _active && _framebufferID != -1) {
+        _rawPenBridge->start();
+    } else {
+        _rawPenBridge->stop();
+    }
+}
+
+QSize FBController::rawPenTargetSize() const
+{
+    const FramebufferPtr framebuffer = currentFramebuffer();
+    if (framebuffer && !framebuffer->image.isNull()) {
+        return framebuffer->image.size();
+    }
+    return QSize(RMPPM_WIDTH, RMPPM_HEIGHT);
+}
+
+void FBController::forwardRawPenPacket(int inputType, int deviceId, int x,
+                                       int y, int pressure)
+{
+    if (_framebufferID == -1 || rawPenOwner != this) {
+        return;
+    }
+    const qtfb::UserInputContents packet {
+        .inputType = inputType,
+        .devId = deviceId,
+        .x = x,
+        .y = y,
+        .d = pressure,
+    };
+    qtfb::management::forwardUserInput(_framebufferID, &packet);
+}
