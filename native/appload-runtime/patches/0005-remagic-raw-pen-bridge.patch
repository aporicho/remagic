diff --git a/src/qtfb/RawPenBridge.cpp b/src/qtfb/RawPenBridge.cpp
new file mode 100644
index 0000000..6844a05
--- /dev/null
+++ b/src/qtfb/RawPenBridge.cpp
@@ -0,0 +1,395 @@
+#include "RawPenBridge.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <climits>
+#include <cstring>
+#include <iostream>
+#include <utility>
+#include <vector>
+
+#include <fcntl.h>
+#include <linux/input.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <QDir>
+#include <QFile>
+#include <QObject>
+#include <QSocketNotifier>
+
+#include "common.h"
+#include "log.h"
+
+namespace {
+constexpr int fallbackWidth = RMPPM_WIDTH;
+constexpr int fallbackHeight = RMPPM_HEIGHT;
+const QString acceptanceMarkerName = QStringLiteral("Remagic acceptance marker");
+
+struct MarkerCandidate {
+    QString eventName;
+    QString deviceName;
+    bool acceptanceDevice = false;
+};
+}
+
+RawPenBridge::RawPenBridge(QObject *eventContext,
+                           TargetSizeProvider targetSize,
+                           PacketSink packetSink)
+    : _eventContext(eventContext)
+    , _targetSize(std::move(targetSize))
+    , _packetSink(std::move(packetSink))
+{
+}
+
+RawPenBridge::~RawPenBridge()
+{
+    stop();
+}
+
+bool RawPenBridge::running() const
+{
+    return _fileDescriptor >= 0;
+}
+
+bool RawPenBridge::start()
+{
+    if (running()) {
+        return true;
+    }
+    if (!_eventContext || !_packetSink || !_targetSize) {
+        CERR << "remagic-runtime: event=raw-pen-unavailable reason=invalid-bridge"
+             << std::endl;
+        return false;
+    }
+
+    QDir inputDirectory(QStringLiteral("/sys/class/input"));
+    const QStringList eventNames = inputDirectory.entryList(
+        QStringList { QStringLiteral("event*") },
+        QDir::Dirs | QDir::System | QDir::NoDotAndDotDot, QDir::Name);
+    std::vector<MarkerCandidate> acceptanceCandidates;
+    std::vector<MarkerCandidate> hardwareCandidates;
+    for (const QString &eventName : eventNames) {
+        QFile nameFile(inputDirectory.filePath(eventName + QStringLiteral("/device/name")));
+        if (!nameFile.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            continue;
+        }
+        const QString deviceName = QString::fromUtf8(nameFile.readAll()).trimmed();
+        if (!deviceName.contains(QStringLiteral("marker"), Qt::CaseInsensitive)) {
+            continue;
+        }
+        const bool acceptanceDevice = deviceName.compare(
+            acceptanceMarkerName, Qt::CaseInsensitive) == 0;
+        MarkerCandidate candidate { eventName, deviceName, acceptanceDevice };
+        (acceptanceDevice ? acceptanceCandidates : hardwareCandidates)
+            .push_back(std::move(candidate));
+    }
+
+    // The acceptance marker is deliberately preferred when present.  It is
+    // hot-plugged while the app is parked and lets device tests inject a
+    // deterministic stroke without ever writing to the real Elan device.
+    for (const auto *candidates : { &acceptanceCandidates, &hardwareCandidates }) {
+        for (const MarkerCandidate &candidate : *candidates) {
+            if (tryOpenDevice(candidate.eventName, candidate.deviceName,
+                              candidate.acceptanceDevice)) {
+                return true;
+            }
+        }
+    }
+
+    const bool foundMarker = !acceptanceCandidates.empty() || !hardwareCandidates.empty();
+    CERR << "remagic-runtime: event=raw-pen-unavailable reason="
+         << (foundMarker ? "marker-open-or-capability-failed" : "no-marker-device")
+         << std::endl;
+    return false;
+}
+
+bool RawPenBridge::tryOpenDevice(const QString &eventName,
+                                 const QString &deviceName,
+                                 bool acceptanceDevice)
+{
+    const QString path = QStringLiteral("/dev/input/") + eventName;
+    const QByteArray encodedPath = QFile::encodeName(path);
+    const int fileDescriptor = ::open(encodedPath.constData(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fileDescriptor < 0) {
+        CERR << "remagic-runtime: event=raw-pen-open-failed device="
+             << path.toStdString() << " name=\"" << deviceName.toStdString()
+             << "\" acceptance_device=" << (acceptanceDevice ? "true" : "false")
+             << " error=\"" << std::strerror(errno) << "\"" << std::endl;
+        return false;
+    }
+
+    _devicePath = path;
+
+    int currentX = 0;
+    int currentY = 0;
+    int currentPressure = 0;
+    AxisRange xRange;
+    AxisRange yRange;
+    AxisRange pressureRange;
+    if (!queryAxis(fileDescriptor, ABS_X, xRange, currentX, "ABS_X")
+        || !queryAxis(fileDescriptor, ABS_Y, yRange, currentY, "ABS_Y")
+        || !queryAxis(fileDescriptor, ABS_PRESSURE, pressureRange,
+                      currentPressure, "ABS_PRESSURE")) {
+        ::close(fileDescriptor);
+        _devicePath.clear();
+        return false;
+    }
+
+    constexpr size_t bitsPerWord = sizeof(unsigned long) * CHAR_BIT;
+    std::array<unsigned long, (KEY_MAX + bitsPerWord) / bitsPerWord> keyBits {};
+    if (::ioctl(fileDescriptor, EVIOCGBIT(EV_KEY, sizeof(keyBits)), keyBits.data()) < 0) {
+        CERR << "remagic-runtime: event=raw-pen-capability-failed device="
+             << path.toStdString() << " capability=EV_KEY error=\""
+             << std::strerror(errno) << "\"" << std::endl;
+        ::close(fileDescriptor);
+        _devicePath.clear();
+        return false;
+    }
+    const auto hasKey = [&keyBits](size_t key) {
+        return (keyBits[key / bitsPerWord] & (1UL << (key % bitsPerWord))) != 0;
+    };
+    if (!hasKey(BTN_TOUCH) || (!hasKey(BTN_TOOL_PEN) && !hasKey(BTN_TOOL_RUBBER))) {
+        CERR << "remagic-runtime: event=raw-pen-capability-failed device="
+             << path.toStdString() << " capability=marker-keys btn_touch="
+             << (hasKey(BTN_TOUCH) ? "true" : "false") << " btn_tool_pen="
+             << (hasKey(BTN_TOOL_PEN) ? "true" : "false")
+             << " btn_tool_rubber=" << (hasKey(BTN_TOOL_RUBBER) ? "true" : "false")
+             << std::endl;
+        ::close(fileDescriptor);
+        _devicePath.clear();
+        return false;
+    }
+
+    _fileDescriptor = fileDescriptor;
+    _xRange = xRange;
+    _yRange = yRange;
+    _pressureRange = pressureRange;
+    _rawX = currentX;
+    _rawY = currentY;
+    _rawPressure = currentPressure;
+    _touchDown = false;
+    _reportedTouchDown = false;
+    _penTool = false;
+    _eraserTool = false;
+    _discardUntilTouchRelease = false;
+    _synchronizationLost = false;
+    _strokeDeviceId = 0;
+
+    _notifier = std::make_unique<QSocketNotifier>(
+        _fileDescriptor, QSocketNotifier::Read, _eventContext);
+    QObject::connect(
+        _notifier.get(), &QSocketNotifier::activated, _eventContext,
+        [this](QSocketDescriptor, QSocketNotifier::Type) { drainEvents(); });
+
+    CERR << "remagic-runtime: event=raw-pen-open device=" << path.toStdString()
+         << " name=\"" << deviceName.toStdString() << "\""
+         << " acceptance_device=" << (acceptanceDevice ? "true" : "false")
+         << " x_min=" << _xRange.minimum << " x_max=" << _xRange.maximum
+         << " y_min=" << _yRange.minimum << " y_max=" << _yRange.maximum
+         << " pressure_min=" << _pressureRange.minimum
+         << " pressure_max=" << _pressureRange.maximum << std::endl;
+    return true;
+}
+
+bool RawPenBridge::queryAxis(int fileDescriptor, int axis, AxisRange &range,
+                             int &currentValue, const char *label) const
+{
+    input_absinfo information {};
+    if (::ioctl(fileDescriptor, EVIOCGABS(axis), &information) < 0) {
+        CERR << "remagic-runtime: event=raw-pen-capability-failed device="
+             << _devicePath.toStdString() << " axis=" << label
+             << " error=\"" << std::strerror(errno) << "\"" << std::endl;
+        return false;
+    }
+    if (information.maximum <= information.minimum) {
+        CERR << "remagic-runtime: event=raw-pen-capability-failed device="
+             << _devicePath.toStdString() << " axis=" << label
+             << " reason=invalid-range minimum=" << information.minimum
+             << " maximum=" << information.maximum << std::endl;
+        return false;
+    }
+    range.minimum = information.minimum;
+    range.maximum = information.maximum;
+    currentValue = information.value;
+    return true;
+}
+
+void RawPenBridge::drainEvents()
+{
+    std::array<input_event, 64> events {};
+    while (_fileDescriptor >= 0) {
+        const ssize_t bytesRead = ::read(_fileDescriptor, events.data(),
+                                         events.size() * sizeof(input_event));
+        if (bytesRead > 0) {
+            if (bytesRead % static_cast<ssize_t>(sizeof(input_event)) != 0) {
+                CERR << "remagic-runtime: event=raw-pen-read-failed device="
+                     << _devicePath.toStdString() << " reason=partial-event bytes="
+                     << bytesRead << std::endl;
+                stop();
+                return;
+            }
+            const size_t eventCount = static_cast<size_t>(bytesRead) / sizeof(input_event);
+            for (size_t index = 0; index < eventCount; ++index) {
+                consumeEvent(events[index].type, events[index].code,
+                             events[index].value);
+            }
+            continue;
+        }
+        if (bytesRead < 0 && errno == EINTR) {
+            continue;
+        }
+        if (bytesRead < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            return;
+        }
+        CERR << "remagic-runtime: event=raw-pen-read-failed device="
+             << _devicePath.toStdString() << " reason="
+             << (bytesRead == 0 ? "end-of-file" : "read-error")
+             << " error=\"" << (bytesRead == 0 ? "none" : std::strerror(errno))
+             << "\"" << std::endl;
+        stop();
+        return;
+    }
+}
+
+void RawPenBridge::consumeEvent(unsigned short type, unsigned short code, int value)
+{
+    if (type == EV_SYN) {
+        if (code == SYN_DROPPED) {
+            CERR << "remagic-runtime: event=raw-pen-sync-lost device="
+                 << _devicePath.toStdString() << std::endl;
+            _synchronizationLost = true;
+            _discardUntilTouchRelease = true;
+            _touchDown = false;
+            return;
+        }
+        if (code == SYN_REPORT) {
+            dispatchReport();
+            _synchronizationLost = false;
+        }
+        return;
+    }
+    if (_synchronizationLost) {
+        return;
+    }
+    if (type == EV_ABS) {
+        switch (code) {
+        case ABS_X: _rawX = value; break;
+        case ABS_Y: _rawY = value; break;
+        case ABS_PRESSURE: _rawPressure = value; break;
+        default: break;
+        }
+        return;
+    }
+    if (type != EV_KEY) {
+        return;
+    }
+    switch (code) {
+    case BTN_TOUCH:
+        _touchDown = value != 0;
+        if (!_touchDown) {
+            _discardUntilTouchRelease = false;
+        }
+        break;
+    case BTN_TOOL_PEN:
+        _penTool = value != 0;
+        if (_penTool) _eraserTool = false;
+        break;
+    case BTN_TOOL_RUBBER:
+        _eraserTool = value != 0;
+        if (_eraserTool) _penTool = false;
+        break;
+    default: break;
+    }
+}
+
+void RawPenBridge::dispatchReport()
+{
+    QSize target = _targetSize();
+    if (target.width() <= 0 || target.height() <= 0) {
+        target = QSize(fallbackWidth, fallbackHeight);
+    }
+    const int x = scaleAxis(_rawX, _xRange, target.width());
+    const int y = scaleAxis(_rawY, _yRange, target.height());
+
+    if (_discardUntilTouchRelease) {
+        if (_reportedTouchDown) {
+            _packetSink(INPUT_PEN_RELEASE, _strokeDeviceId, x, y, 0);
+            _reportedTouchDown = false;
+        }
+        return;
+    }
+    if (_touchDown) {
+        const int inputType = _reportedTouchDown ? INPUT_PEN_UPDATE : INPUT_PEN_PRESS;
+        if (!_reportedTouchDown) {
+            _strokeDeviceId = _eraserTool ? 1 : 0;
+        }
+        _packetSink(inputType, _strokeDeviceId, x, y,
+                    scalePressure(_rawPressure));
+        _reportedTouchDown = true;
+        return;
+    }
+    if (_reportedTouchDown) {
+        _packetSink(INPUT_PEN_RELEASE, _strokeDeviceId, x, y, 0);
+        _reportedTouchDown = false;
+    }
+}
+
+void RawPenBridge::releaseReportedStroke()
+{
+    if (!_reportedTouchDown || !_packetSink) {
+        return;
+    }
+    QSize target = _targetSize ? _targetSize() : QSize();
+    if (target.width() <= 0 || target.height() <= 0) {
+        target = QSize(fallbackWidth, fallbackHeight);
+    }
+    _packetSink(INPUT_PEN_RELEASE, _strokeDeviceId,
+                scaleAxis(_rawX, _xRange, target.width()),
+                scaleAxis(_rawY, _yRange, target.height()), 0);
+    _reportedTouchDown = false;
+}
+
+int RawPenBridge::scaleAxis(int value, const AxisRange &range, int extent) const
+{
+    if (extent <= 1 || range.maximum <= range.minimum) {
+        return 0;
+    }
+    const qint64 clamped = std::clamp<qint64>(value, range.minimum, range.maximum);
+    const qint64 span = static_cast<qint64>(range.maximum) - range.minimum;
+    return static_cast<int>(((clamped - range.minimum) * (extent - 1) + span / 2) / span);
+}
+
+int RawPenBridge::scalePressure(int value) const
+{
+    return scaleAxis(value, _pressureRange, 101);
+}
+
+void RawPenBridge::closeDevice()
+{
+    if (_notifier) {
+        _notifier->setEnabled(false);
+        _notifier.reset();
+    }
+    if (_fileDescriptor >= 0) {
+        ::close(_fileDescriptor);
+        _fileDescriptor = -1;
+    }
+    _devicePath.clear();
+}
+
+void RawPenBridge::stop()
+{
+    if (!running() && !_notifier) {
+        return;
+    }
+    releaseReportedStroke();
+    CERR << "remagic-runtime: event=raw-pen-close device="
+         << _devicePath.toStdString() << std::endl;
+    closeDevice();
+    _touchDown = false;
+    _reportedTouchDown = false;
+    _discardUntilTouchRelease = false;
+    _synchronizationLost = false;
+}
