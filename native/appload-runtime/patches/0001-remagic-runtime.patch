diff -ruN '--exclude=.git' a/src/RuntimeControl.cpp b/src/RuntimeControl.cpp
--- a/src/RuntimeControl.cpp	1970-01-01 08:00:00.000000000 +0800
+++ b/src/RuntimeControl.cpp	2026-07-20 18:38:15.149933077 +0800
@@ -0,0 +1,392 @@
+#include "RuntimeControl.h"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJSEngine>
+#include <QJsonDocument>
+#include <QJsonParseError>
+#include <QLocalServer>
+#include <QLocalSocket>
+#include <QProcess>
+#include <QQmlEngine>
+
+#include <iostream>
+
+#include "log.h"
+
+namespace {
+constexpr qsizetype MaximumRequestBytes = 64 * 1024;
+constexpr qsizetype MaximumRememberedResponses = 128;
+}
+
+RuntimeControl *RuntimeControl::instance = nullptr;
+
+RuntimeControl::RuntimeControl(QObject *parent)
+    : QObject(parent), _server(new QLocalServer(this))
+{
+    Q_ASSERT(!instance);
+    instance = this;
+    _socketPath = qEnvironmentVariable(
+        "REMAGIC_RUNTIME_SOCKET",
+        qEnvironmentVariable("REMAGIC_RUNTIME_APP_SOCKET", "/run/remagic/runtime-app.sock"));
+    connect(_server, &QLocalServer::newConnection, this, &RuntimeControl::acceptConnections);
+}
+
+RuntimeControl::~RuntimeControl()
+{
+    stop();
+    if (instance == this) instance = nullptr;
+}
+
+QObject *RuntimeControl::qmlSingleton(QQmlEngine *engine, QJSEngine *scriptEngine)
+{
+    Q_UNUSED(scriptEngine);
+    Q_ASSERT(instance);
+    QQmlEngine::setObjectOwnership(instance, QQmlEngine::CppOwnership);
+    Q_UNUSED(engine);
+    return instance;
+}
+
+bool RuntimeControl::reportUnexpectedExit(const QString &app)
+{
+    if (!instance || app.isEmpty()) return false;
+    QString publicApp = app;
+    if (publicApp.startsWith("external::")) publicApp.remove(0, 10);
+    const bool dispatched = instance->dispatchRemagicctl({"close", publicApp});
+    if (dispatched) {
+        CERR << "remagic-runtime: app=" << publicApp.toStdString()
+             << " event=daemon-notified action=close" << std::endl;
+    }
+    return dispatched;
+}
+
+bool RuntimeControl::start()
+{
+    if (_server->isListening()) return true;
+    const QFileInfo socketInfo(_socketPath);
+    if (!QDir().mkpath(socketInfo.absolutePath())) {
+        CERR << "Cannot create runtime control directory "
+             << socketInfo.absolutePath().toStdString() << std::endl;
+        return false;
+    }
+    QLocalServer::removeServer(_socketPath);
+    if (!_server->listen(_socketPath)) {
+        CERR << "Cannot listen on runtime control socket " << _socketPath.toStdString()
+             << ": " << _server->errorString().toStdString() << std::endl;
+        return false;
+    }
+    QFile::setPermissions(_socketPath, QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+    emit listeningChanged();
+    CERR << "Runtime control ready at " << _socketPath.toStdString() << std::endl;
+    return true;
+}
+
+void RuntimeControl::stop()
+{
+    if (!_server) return;
+    const bool wasListening = _server->isListening();
+    for (QLocalSocket *client : _buffers.keys()) {
+        client->disconnect(this);
+        client->abort();
+        client->deleteLater();
+    }
+    _buffers.clear();
+    _server->close();
+    QLocalServer::removeServer(_socketPath);
+    QFile::remove(_socketPath);
+    if (wasListening) emit listeningChanged();
+}
+
+bool RuntimeControl::listening() const
+{
+    return _server && _server->isListening();
+}
+
+void RuntimeControl::setAppState(const QString &app, const QString &state)
+{
+    if (app.isEmpty()) return;
+    AppRuntimeStatus &status = _appStatuses[app];
+    if (state == "starting" && (status.generation == 0 || _activeApp != app)) {
+        status.generation = ++_generation;
+        status.error.clear();
+        status.qtfbConnected = false;
+        status.firstFrame = false;
+        _activeApp = app;
+    }
+    if (state == "foreground") {
+        _activeApp = app;
+        _managerVisible = false;
+    }
+    if (state == "exited" || state == "crashed" || state == "unavailable" || state == "error") {
+        status.qtfbConnected = false;
+        status.firstFrame = false;
+    }
+    if (status.state == state) return;
+    status.state = state;
+    CERR << "remagic-runtime: app=" << app.toStdString()
+         << " event=" << state.toStdString() << std::endl;
+}
+
+void RuntimeControl::beginAppLaunch(const QString &app)
+{
+    if (app.isEmpty()) return;
+    AppRuntimeStatus &status = _appStatuses[app];
+    status.generation = ++_generation;
+    status.state = "starting";
+    status.error.clear();
+    status.qtfbConnected = false;
+    status.firstFrame = false;
+    _activeApp = app;
+    _managerVisible = false;
+    CERR << "remagic-runtime: app=" << app.toStdString()
+         << " event=starting generation=" << status.generation << std::endl;
+}
+
+void RuntimeControl::setAppError(const QString &app, const QString &error)
+{
+    if (app.isEmpty()) return;
+    _appStatuses[app].error = error;
+}
+
+void RuntimeControl::recordAppEvent(const QString &app, const QString &event)
+{
+    if (app.isEmpty() || event.isEmpty()) return;
+    AppRuntimeStatus &status = _appStatuses[app];
+    if (event == "qtfb-connected") status.qtfbConnected = true;
+    else if (event == "qtfb-disconnected") {
+        status.qtfbConnected = false;
+        status.firstFrame = false;
+    } else if (event == "first-frame") status.firstFrame = true;
+    CERR << "remagic-runtime: app=" << app.toStdString()
+         << " event=" << event.toStdString() << std::endl;
+}
+
+void RuntimeControl::recordUiEvent(const QString &ui, const QString &app, const QString &event)
+{
+    if (ui.isEmpty() || event.isEmpty()) return;
+    CERR << "remagic-runtime: ui=" << ui.toStdString();
+    if (!app.isEmpty()) std::cerr << " app=" << app.toStdString();
+    std::cerr << " event=" << event.toStdString() << std::endl;
+}
+
+void RuntimeControl::setManagerVisible(bool visible)
+{
+    _managerVisible = visible;
+}
+
+bool RuntimeControl::dispatchRemagicctl(const QStringList &arguments)
+{
+    const QString executable = qEnvironmentVariable(
+        "REMAGICCTL_PATH", "/home/root/apps/remagic/bin/remagicctl");
+    qint64 pid = 0;
+    const bool started = QProcess::startDetached(executable, arguments, QString(), &pid);
+    if (!started) CERR << "Failed to dispatch " << executable.toStdString() << std::endl;
+    return started;
+}
+
+bool RuntimeControl::requestLaunch(const QString &app, const QString &openPath)
+{
+    if (app.isEmpty()) return false;
+    QStringList arguments {"launch", app};
+    if (!openPath.isEmpty()) arguments << "--open-path" << openPath;
+    const bool accepted = dispatchRemagicctl(arguments);
+    if (accepted) setAppState(app, "requested");
+    return accepted;
+}
+
+bool RuntimeControl::requestClose(const QString &app)
+{
+    return !app.isEmpty() && dispatchRemagicctl({"close", app, "--complete"});
+}
+
+bool RuntimeControl::requestPark()
+{
+    return dispatchRemagicctl({"park"});
+}
+
+bool RuntimeControl::requestSystem()
+{
+    return dispatchRemagicctl({"system"});
+}
+
+void RuntimeControl::acceptConnections()
+{
+    while (_server->hasPendingConnections()) {
+        QLocalSocket *client = _server->nextPendingConnection();
+        if (!client) continue;
+        _buffers.insert(client, {});
+        connect(client, &QLocalSocket::readyRead, this, [this, client]() { readClient(client); });
+        connect(client, &QLocalSocket::disconnected, this, [this, client]() {
+            _buffers.remove(client);
+            client->deleteLater();
+        });
+        readClient(client);
+    }
+}
+
+void RuntimeControl::readClient(QLocalSocket *client)
+{
+    auto position = _buffers.find(client);
+    if (position == _buffers.end()) return;
+    position.value().append(client->readAll());
+    if (position.value().size() > MaximumRequestBytes && !position.value().contains('\n')) {
+        QJsonObject response;
+        response.insert("version", 1);
+        response.insert("ok", false);
+        response.insert("status", "error");
+        response.insert("error", "request_too_large");
+        writeResponse(client, response, false);
+        client->disconnectFromServer();
+        return;
+    }
+
+    for (;;) {
+        const qsizetype newline = position.value().indexOf('\n');
+        if (newline < 0) break;
+        QByteArray line = position.value().left(newline).trimmed();
+        position.value().remove(0, newline + 1);
+        if (!line.isEmpty()) processLine(client, line);
+    }
+}
+
+QJsonObject RuntimeControl::baseResponse(const QString &requestId) const
+{
+    QJsonObject response;
+    response.insert("version", 1);
+    response.insert("request_id", requestId);
+    return response;
+}
+
+QJsonObject RuntimeControl::statusResponse(const QString &requestId) const
+{
+    QJsonObject response = baseResponse(requestId);
+    response.insert("ok", true);
+    response.insert("status", "ok");
+    response.insert("manager_visible", _managerVisible);
+    response.insert("active_app", _activeApp);
+    const AppRuntimeStatus activeStatus = _appStatuses.value(_activeApp);
+    response.insert("state", _activeApp.isEmpty() ? "manager" : activeStatus.state);
+    response.insert("qtfb_connected", activeStatus.qtfbConnected);
+    response.insert("first_frame", activeStatus.firstFrame);
+    response.insert("generation", static_cast<double>(activeStatus.generation));
+    if (!activeStatus.error.isEmpty()) response.insert("error", activeStatus.error);
+    QJsonObject apps;
+    QJsonObject appStatuses;
+    for (auto position = _appStatuses.cbegin(); position != _appStatuses.cend(); ++position) {
+        apps.insert(position.key(), position.value().state);
+        QJsonObject details;
+        details.insert("state", position.value().state);
+        details.insert("qtfb_connected", position.value().qtfbConnected);
+        details.insert("first_frame", position.value().firstFrame);
+        details.insert("generation", static_cast<double>(position.value().generation));
+        if (!position.value().error.isEmpty()) details.insert("error", position.value().error);
+        appStatuses.insert(position.key(), details);
+    }
+    response.insert("apps", apps);
+    response.insert("app_statuses", appStatuses);
+    return response;
+}
+
+void RuntimeControl::processLine(QLocalSocket *client, const QByteArray &line)
+{
+    QJsonParseError parseError;
+    const QJsonDocument document = QJsonDocument::fromJson(line, &parseError);
+    if (parseError.error != QJsonParseError::NoError || !document.isObject()) {
+        QJsonObject response;
+        response.insert("version", 1);
+        response.insert("ok", false);
+        response.insert("status", "error");
+        response.insert("error", "invalid_json");
+        writeResponse(client, response, false);
+        return;
+    }
+
+    const QJsonObject request = document.object();
+    const QString requestId = request.value("request_id").toString();
+    if (!requestId.isEmpty()) {
+        const auto previous = _recentResponses.constFind(requestId);
+        if (previous != _recentResponses.cend()) {
+            client->write(previous.value());
+            client->flush();
+            return;
+        }
+    }
+
+    QJsonObject response = baseResponse(requestId);
+    if (request.value("version").toInt(-1) != 1 || requestId.isEmpty()) {
+        response.insert("ok", false);
+        response.insert("status", "error");
+        response.insert("error", "invalid_envelope");
+        writeResponse(client, response, false);
+        return;
+    }
+
+    const QString command = request.value("command").toString();
+    if (command == "status") {
+        writeResponse(client, statusResponse(requestId), true);
+        return;
+    }
+    const bool fromDaemon = request.value("source").toString() == "daemon";
+    bool dispatched = true;
+    if (command == "show_manager") {
+        if (fromDaemon) emit showManagerRequested();
+        else dispatched = requestPark();
+    } else if (command == "open_app") {
+        const QString app = request.value("app").toString();
+        if (app.isEmpty()) {
+            response.insert("ok", false);
+            response.insert("status", "error");
+            response.insert("error", "missing_app");
+            writeResponse(client, response, true);
+            return;
+        }
+        const QString openPath = request.value("open_path").toString();
+        if (fromDaemon) emit openAppRequested(app, openPath);
+        else dispatched = requestLaunch(app, openPath);
+    } else if (command == "close_app") {
+        const QString app = request.value("app").toString();
+        if (app.isEmpty()) {
+            response.insert("ok", false);
+            response.insert("status", "error");
+            response.insert("error", "missing_app");
+            writeResponse(client, response, true);
+            return;
+        }
+        if (fromDaemon) emit closeAppRequested(app);
+        else dispatched = requestClose(app);
+    } else {
+        response.insert("ok", false);
+        response.insert("status", "error");
+        response.insert("error", "unknown_command");
+        writeResponse(client, response, true);
+        return;
+    }
+
+    response.insert("ok", dispatched);
+    response.insert("accepted", dispatched);
+    response.insert("status", dispatched ? "accepted" : "error");
+    if (!dispatched) response.insert("error", "daemon_dispatch_failed");
+    writeResponse(client, response, true);
+}
+
+void RuntimeControl::writeResponse(QLocalSocket *client, const QJsonObject &response, bool remember)
+{
+    QByteArray bytes = QJsonDocument(response).toJson(QJsonDocument::Compact);
+    bytes.append('\n');
+    if (remember) {
+        rememberResponse(response.value("request_id").toString(), bytes);
+    }
+    client->write(bytes);
+    client->flush();
+}
+
+void RuntimeControl::rememberResponse(const QString &requestId, const QByteArray &response)
+{
+    if (requestId.isEmpty()) return;
+    if (!_recentResponses.contains(requestId)) _responseOrder.enqueue(requestId);
+    _recentResponses.insert(requestId, response);
+    while (_responseOrder.size() > MaximumRememberedResponses) {
+        _recentResponses.remove(_responseOrder.dequeue());
+    }
+}
