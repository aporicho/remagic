-bool qtfb::ClientConnection::pollServerPacket(struct ServerMessage &message) {
-    if(recv(fd, &message, sizeof(message), 0) < 1) {
-        return false;
-    }
-    return true;
+bool qtfb::ClientConnection::pollServerPacket(ServerMessage &message, int timeoutMilliseconds)
+{
+    pollfd descriptor {.fd = fd, .events = POLLIN, .revents = 0};
+    int result;
+    do {
+        result = poll(&descriptor, 1, timeoutMilliseconds);
+    } while (result < 0 && errno == EINTR);
+    if (result <= 0 || !(descriptor.revents & POLLIN)) return false;
+    return recv(fd, &message, sizeof(message), 0) == static_cast<ssize_t>(sizeof(message));
 }
 
