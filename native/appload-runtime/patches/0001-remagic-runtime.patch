+
+QRect FBController::sourceRectToItem(const QRect &requested, const FramebufferPtr &framebuffer) const
+{
+    const QRect itemBounds(0, 0, qMax(0, qCeil(width())), qMax(0, qCeil(height())));
+    if (!framebuffer || framebuffer->image.isNull()) {
+        return requested.isValid() ? requested.intersected(itemBounds) : itemBounds;
+    }
+
+    const QRect source = requested.isValid()
+        ? requested.normalized().intersected(framebuffer->image.rect())
+        : framebuffer->image.rect();
+    if (source.isEmpty()) {
+        return {};
+    }
+    if (!scalingActive(framebuffer)) {
+        return source.intersected(itemBounds);
+    }
+
+    const int sourceWidth = framebuffer->image.width();
+    const int sourceHeight = framebuffer->image.height();
+    const int itemWidth = itemBounds.width();
+    const int itemHeight = itemBounds.height();
+    const int left = scaleFloor(source.x(), itemWidth, sourceWidth);
+    const int top = scaleFloor(source.y(), itemHeight, sourceHeight);
+    const int right = scaleCeil(source.x() + source.width(), itemWidth, sourceWidth);
+    const int bottom = scaleCeil(source.y() + source.height(), itemHeight, sourceHeight);
+    return QRect(left, top, right - left, bottom - top).intersected(itemBounds);
+}
+
+QRect FBController::itemRectToSource(const QRect &requested, const FramebufferPtr &framebuffer) const
+{
+    if (!framebuffer || framebuffer->image.isNull()) {
+        return {};
+    }
+    const QRect itemBounds(0, 0, qMax(0, qCeil(width())), qMax(0, qCeil(height())));
+    const QRect itemRect = requested.normalized().intersected(itemBounds);
+    if (itemRect.isEmpty()) {
+        return {};
+    }
+    if (!scalingActive(framebuffer)) {
+        return itemRect.intersected(framebuffer->image.rect());
+    }
+
+    const int left = scaleFloor(itemRect.x(), framebuffer->image.width(), itemBounds.width());
+    const int top = scaleFloor(itemRect.y(), framebuffer->image.height(), itemBounds.height());
+    const int right = scaleCeil(itemRect.x() + itemRect.width(), framebuffer->image.width(), itemBounds.width());
+    const int bottom = scaleCeil(itemRect.y() + itemRect.height(), framebuffer->image.height(), itemBounds.height());
+    return QRect(left, top, right - left, bottom - top).intersected(framebuffer->image.rect());
