+
+class QJSEngine;
+class QLocalServer;
+class QLocalSocket;
+class QQmlEngine;
+
+class RuntimeControl : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool listening READ listening NOTIFY listeningChanged)
+public:
+    explicit RuntimeControl(QObject *parent = nullptr);
+    ~RuntimeControl() override;
+
+    static QObject *qmlSingleton(QQmlEngine *engine, QJSEngine *scriptEngine);
+    // Notify the daemon when a managed child disappears without a preceding
+    // daemon close request. This is intentionally fire-and-forget so the
+    // QProcess finished handler can never block the GUI event loop.
+    static bool reportUnexpectedExit(const QString &app);
+
+    Q_INVOKABLE bool start();
+    Q_INVOKABLE void stop();
+    Q_INVOKABLE void beginAppLaunch(const QString &app);
+    Q_INVOKABLE void setAppState(const QString &app, const QString &state);
+    Q_INVOKABLE void setAppError(const QString &app, const QString &error);
+    Q_INVOKABLE void recordAppEvent(const QString &app, const QString &event);
+    Q_INVOKABLE void recordUiEvent(const QString &ui, const QString &app, const QString &event);
+    Q_INVOKABLE void setManagerVisible(bool visible);
+    Q_INVOKABLE bool requestLaunch(const QString &app, const QString &openPath = QString());
+    Q_INVOKABLE bool requestClose(const QString &app);
+    Q_INVOKABLE bool requestPark();
+    Q_INVOKABLE bool requestSystem();
+    bool listening() const;
+
+signals:
+    void listeningChanged();
+    void openAppRequested(QString app, QString openPath);
+    void closeAppRequested(QString app);
+    void showManagerRequested();
+
+private:
+    struct AppRuntimeStatus {
+        QString state;
+        QString error;
+        quint64 generation = 0;
+        bool qtfbConnected = false;
+        bool firstFrame = false;
+    };
+
+    void acceptConnections();
+    void readClient(QLocalSocket *client);
+    void processLine(QLocalSocket *client, const QByteArray &line);
+    void writeResponse(QLocalSocket *client, const QJsonObject &response, bool remember);
+    QJsonObject baseResponse(const QString &requestId) const;
+    QJsonObject statusResponse(const QString &requestId) const;
+    void rememberResponse(const QString &requestId, const QByteArray &response);
+    bool dispatchRemagicctl(const QStringList &arguments);
+
+    static RuntimeControl *instance;
+    QLocalServer *_server = nullptr;
+    QString _socketPath;
+    QHash<QLocalSocket *, QByteArray> _buffers;
+    QHash<QString, QByteArray> _recentResponses;
+    QQueue<QString> _responseOrder;
+    QHash<QString, AppRuntimeStatus> _appStatuses;
+    QString _activeApp;
+    quint64 _generation = 0;
+    bool _managerVisible = true;
+};
