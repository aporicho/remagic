+void appload::library::shutdownExternalApplications()
+{
+    std::vector<std::pair<qint64, QPointer<QProcess>>> processes;
+    processes.reserve(externalProcesses.size());
+    for (const auto &[applicationID, process] : externalProcesses) {
+        Q_UNUSED(applicationID);
+        if (!process || process->state() == QProcess::NotRunning) continue;
+        const qint64 pid = process->processId();
+        process->setProperty("remagicExpectedExit", true);
+        processes.emplace_back(pid, process);
+        signalProcessGroup(pid, SIGTERM);
+    }
+
+    for (const auto &[pid, process] : processes) {
+        Q_UNUSED(pid);
+        if (process && process->state() != QProcess::NotRunning) process->waitForFinished(2000);
+    }
+    for (const auto &[pid, process] : processes) {
+        if (process && process->state() != QProcess::NotRunning) {
+            signalProcessGroup(pid, SIGKILL);
+            process->waitForFinished(1000);
+        }
