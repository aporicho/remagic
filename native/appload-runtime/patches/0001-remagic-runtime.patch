+std::shared_ptr<qtfb::management::SharedFramebuffer> createSHM(int shmType, int width, int height)
+{
+    if (width <= 0 || height <= 0) {
+        CERR << "Invalid framebuffer dimensions " << width << "x" << height << std::endl;
+        return {};
+    }
+
+    size_t shmSize = 0;
+    QImage::Format format = QImage::Format_Invalid;
+    int bytesPerLine = 0;
+    switch (shmType) {
+    case FBFMT_RM2FB:
+    case FBFMT_RMPP_RGB565:
+    case FBFMT_RMPPM_RGB565:
+        shmSize = static_cast<size_t>(height) * width * 2;
+        bytesPerLine = 2 * width;
+        format = QImage::Format_RGB16;
+        break;
+    case FBFMT_RMPP_RGB888:
+    case FBFMT_RMPPM_RGB888:
+        shmSize = static_cast<size_t>(height) * width * 3;
+        bytesPerLine = 3 * width;
+        format = QImage::Format_RGB888;
+        break;
+    case FBFMT_RMPP_RGBA8888:
+    case FBFMT_RMPPM_RGBA8888:
+        shmSize = static_cast<size_t>(height) * width * 4;
+        bytesPerLine = 4 * width;
+        format = QImage::Format_RGBA8888;
+        break;
+    default:
+        CERR << "Unknown SHM type " << shmType << std::endl;
+        return {};
+    }
+
+    auto framebuffer = std::make_shared<qtfb::management::SharedFramebuffer>();
+    framebuffer->shmSize = shmSize;
+    framebuffer->shmType = shmType;
+
+    char shmName[32] = {};
+    for (int attempt = 0; attempt < 128; ++attempt) {
+        framebuffer->shmKey = static_cast<int>(nextShmKey.fetch_add(1) & 0x7fffffffU);
+        if (framebuffer->shmKey == 0) {
+            continue;
+        }
+        std::snprintf(shmName, sizeof(shmName), "/qtfb_%d", framebuffer->shmKey);
+        framebuffer->shmFD = shm_open(shmName, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, S_IRUSR | S_IWUSR);
+        if (framebuffer->shmFD >= 0) {
+            break;
+        }
+        if (errno != EEXIST) {
+            CERR << "Failed to shm_open(): " << std::strerror(errno) << std::endl;
+            return {};
+        }
+    }
+    if (framebuffer->shmFD < 0) {
+        CERR << "Could not allocate a unique QTFB shared-memory key" << std::endl;
+        return {};
+    }
+
+    if (ftruncate(framebuffer->shmFD, static_cast<off_t>(shmSize)) == -1) {
+        CERR << "Failed to resize QTFB shared memory: " << std::strerror(errno) << std::endl;
+        return {};
+    }
+    framebuffer->shm = static_cast<unsigned char *>(
+        mmap(nullptr, shmSize, PROT_READ | PROT_WRITE, MAP_SHARED, framebuffer->shmFD, 0));
+    if (framebuffer->shm == MAP_FAILED) {
+        framebuffer->shm = nullptr;
+        CERR << "Failed to mmap QTFB shared memory: " << std::strerror(errno) << std::endl;
+        return {};
+    }
+
+    std::memset(framebuffer->shm, 0xFF, shmSize);
+    framebuffer->image = QImage(framebuffer->shm, width, height, bytesPerLine, format);
+    CERR << "Defined SHM (" << shmSize << " bytes) for " << width << "x" << height << std::endl;
+    return framebuffer;
+}
