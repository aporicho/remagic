+        const int pollStatus = poll(&descriptor, 1, 250);
+        if (pollStatus < 0) {
+            if (errno == EINTR) continue;
+            break;
+        }
+        if (pollStatus == 0) continue;
+        if (!(descriptor.revents & POLLIN)) {
+            if (descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)) break;
+            continue;
+        }
+
+        const int incomingFD = accept4(listeningFD, nullptr, nullptr, SOCK_CLOEXEC);
+        if (incomingFD < 0) {
+            if (errno == EINTR) continue;
+            if (!serverRunning.load()) break;
+            CERR << "Failed to accept QTFB connection: " << std::strerror(errno) << std::endl;
+            continue;
+        }
+        if (!serverRunning.load(std::memory_order_acquire)) {
+            close(incomingFD);
+            break;
+        }
+        {
+            std::lock_guard<std::mutex> lock(serverMutex);
+            activeClientSockets.insert(incomingFD);
+        }
+        clientThreads.emplace_back(managementClientThread, incomingFD);
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(serverMutex);
+        for (const int clientFD : activeClientSockets) {
+            shutdown(clientFD, SHUT_RDWR);
+        }
+    }
+    for (std::thread &thread : clientThreads) {
+        if (thread.joinable()) thread.join();
+    }
+
+    int listeningFD = -1;
+    {
+        std::lock_guard<std::mutex> lock(serverMutex);
+        listeningFD = std::exchange(serverSocket, -1);
+    }
+    if (listeningFD >= 0) close(listeningFD);
+    unlink(SOCKET_PATH);
