+void appload::library::terminateExternal(qint64 pid)
+{
+    const auto id = applicationForPid.find(pid);
+    if (id == applicationForPid.end()) return;
+    const auto processPosition = externalProcesses.find(id->second);
+    if (processPosition == externalProcesses.end() || !processPosition->second) return;
+
+    QPointer<QProcess> process = processPosition->second;
+    if (process->state() == QProcess::NotRunning) return;
+    if (process->property("remagicTerminating").toBool()) return;
+    process->setProperty("remagicTerminating", true);
+    process->setProperty("remagicExpectedExit", true);
+    signalProcessGroup(pid, SIGTERM);
+    QTimer::singleShot(2000, QCoreApplication::instance(), [pid, process]() {
+        if (process && process->state() != QProcess::NotRunning) {
+            signalProcessGroup(pid, SIGKILL);
+        }
+    });
 }
 
