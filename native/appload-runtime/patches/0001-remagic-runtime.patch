+bool qtfb::management::start()
+{
+    if (serverRunning.exchange(true)) return true;
+
+    const int socketFD = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    if (socketFD < 0) {
+        serverRunning.store(false);
+        return false;
+    }
+
+    sockaddr_un address {};
+    address.sun_family = AF_UNIX;
+    std::strncpy(address.sun_path, SOCKET_PATH, sizeof(address.sun_path) - 1);
+    unlink(SOCKET_PATH);
+    if (bind(socketFD, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == -1
+        || listen(socketFD, SocketBacklog) == -1) {
+        CERR << "Failed to start QTFB socket: " << std::strerror(errno) << std::endl;
+        close(socketFD);
+        unlink(SOCKET_PATH);
+        serverRunning.store(false);
+        return false;
+    }
+    chmod(SOCKET_PATH, S_IRUSR | S_IWUSR);
+
+    {
+        std::lock_guard<std::mutex> lock(serverMutex);
+        serverSocket = socketFD;
+    }
+    serverThread = std::thread(managementMainThread);
+    return true;
+}
+
+void qtfb::management::stop()
+{
+    serverRunning.store(false, std::memory_order_release);
+    {
+        std::lock_guard<std::mutex> lock(serverMutex);
+        if (serverSocket >= 0) shutdown(serverSocket, SHUT_RDWR);
+        for (const int clientFD : activeClientSockets) shutdown(clientFD, SHUT_RDWR);
+    }
+    if (serverThread.joinable()) serverThread.join();
+
+    std::map<FBKey, std::unique_ptr<ClientBackend>> leftovers;
+    {
+        std::lock_guard<std::mutex> lock(backendsMutex);
+        leftovers.swap(connections);
+    }
+    unlink(SOCKET_PATH);
+}
+
+void qtfb::management::forwardUserInput(FBKey key, const UserInputContents *input)
+{
+    if (!input) return;
+    std::lock_guard<std::mutex> lock(backendsMutex);
+    const auto position = connections.find(key);
+    if (position == connections.end()) return;
+
+    const ServerMessage outbound {
+        .type = MESSAGE_USERINPUT,
+        .userInput = *input,
+    };
+    for (ClientConnection *connection : position->second->connections) {
+        sendMessage(connection, outbound);
     }
