+bool FBController::scalingActive(const FramebufferPtr &framebuffer) const
+{
+    if (!_allowScaling || !framebuffer || framebuffer->image.isNull()) {
+        return false;
+    }
+    // Avoid the scaling path entirely on Move's native 954x1696 canvas (and
+    // any other exact-size canvas). Apart from being cheaper, this preserves
+    // one source pixel per panel pixel for small dirty regions.
+    return qRound(width()) != framebuffer->image.width()
+        || qRound(height()) != framebuffer->image.height();
