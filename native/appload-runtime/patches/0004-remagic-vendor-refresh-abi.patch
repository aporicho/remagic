+void *resolveEpaperSymbol(const char *name)
+{
+    if (void *symbol = dlsym(RTLD_DEFAULT, name)) {
+        return symbol;
+    }
+    // Qt loads scenegraph backends as local plugins, so their symbols are not
+    // required to appear in RTLD_DEFAULT.  Reuse the already-loaded plugin;
+    // never load a second EPFramebuffer instance merely to resolve a symbol.
+    static void *plugin = dlopen("/usr/lib/plugins/scenegraph/libqsgepaper.so",
+                                 RTLD_NOW | RTLD_NOLOAD);
+    return plugin ? dlsym(plugin, name) : nullptr;
+}
