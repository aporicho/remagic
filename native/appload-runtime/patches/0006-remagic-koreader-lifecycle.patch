+QByteArray applicationIdentity(qint64 pid, quint64 generation)
+{
+    return QByteArrayLiteral("pid=") + QByteArray::number(pid)
+        + QByteArrayLiteral("\ngeneration=") + QByteArray::number(generation)
+        + QByteArrayLiteral("\n");
+}
+
+bool writeApplicationMarker(const QString &path, qint64 pid, quint64 generation)
+{
+    QSaveFile marker(path);
+    marker.setDirectWriteFallback(false);
+    if (!marker.open(QIODevice::WriteOnly | QIODevice::Text)) return false;
+    const QByteArray identity = applicationIdentity(pid, generation);
+    return marker.write(identity) == identity.size() && marker.commit();
+}
+
+void removeOwnedApplicationMarker(const QString &path, qint64 pid, quint64 generation)
+{
+    QFile marker(path);
+    if (!marker.open(QIODevice::ReadOnly | QIODevice::Text)) return;
+    const bool owned = marker.readAll() == applicationIdentity(pid, generation);
+    marker.close();
+    if (owned) QFile::remove(path);
+}
 }
 
