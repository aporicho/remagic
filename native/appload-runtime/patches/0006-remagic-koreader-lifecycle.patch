+bool RuntimeControl::applicationSemanticReady(const QString &app, qint64 pid) const
+{
+    if (app != QStringLiteral("koreader") || pid <= 1) return true;
+    const auto position = _appStatuses.constFind(app);
+    if (position == _appStatuses.cend() || position->generation == 0) return false;
+
+    QFile marker(QStringLiteral("/run/remagic/koreader-ready"));
+    if (!marker.open(QIODevice::ReadOnly | QIODevice::Text)) return false;
+    const QByteArray expected = QByteArrayLiteral("pid=") + QByteArray::number(pid)
+        + QByteArrayLiteral("\ngeneration=") + QByteArray::number(position->generation)
+        + QByteArrayLiteral("\n");
+    return marker.readAll() == expected;
+}
